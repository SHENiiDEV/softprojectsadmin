# Production template for https://soft-projects.io
# Copy to /var/www/softprojects-admin/.env and replace every __PLACEHOLDER__ (see DEPLOY.md, step 7).

APP_NAME="SoftProject Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://soft-projects.io
APP_TIMEZONE=Europe/Riga

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (isolated MySQL user, see DEPLOY.md step 4) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=softprojects
DB_USERNAME=softprojects
DB_PASSWORD=__DB_PASSWORD__

# --- Session / cache / queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be larger than the longest worker --timeout (gmail worker uses 300s), otherwise jobs run twice
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database

# --- Mail (SMTP can also be overridden later in Settings -> SMTP) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=__SMTP_HOST__
MAIL_PORT=587
MAIL_USERNAME=__SMTP_USER__
MAIL_PASSWORD=__SMTP_PASSWORD__
MAIL_FROM_ADDRESS="noreply@soft-projects.io"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=__TELEGRAM_BOT_TOKEN__
TELEGRAM_BOT_USERNAME=pm_compliance_bot
# openssl rand -hex 32  (must be set before `php artisan telegram:set-webhook`)
TELEGRAM_WEBHOOK_SECRET=__TELEGRAM_WEBHOOK_SECRET__

# --- Gmail integration ---
# openssl rand -hex 32  (HMAC secret for /api/v1/webhooks/gmail-alert)
GMAIL_WEBHOOK_SECRET=__GMAIL_WEBHOOK_SECRET__
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PUBSUB_TOPIC=
# Ignore mail older than this date, e.g. 2026-01-01 (leave empty to disable)
GMAIL_SYNC_MIN_DATE=

# --- Feature flags (defaults are in config/features.php; adjust to taste) ---
ENABLE_MY_WORK=true
ENABLE_ACTIVITY_CENTER=true
